# Copy this file to .env (and add the same keys in Vercel → Project Settings →
# Environment Variables for production). Never commit the real .env file.

# ── Payments ─────────────────────────────────────────────────────────────
# UPI ID used for the PhonePe/GPay donation flow (App.tsx donation modal).
VITE_UPI_ID=

# Ko-fi page URL used for international (USD) donations.
VITE_KOFI_LINK=

# ── Auth ─────────────────────────────────────────────────────────────────
# Google OAuth client ID for "Sign in with Google". If unset, the sign-in
# button is hidden entirely rather than crashing.
VITE_GOOGLE_CLIENT_ID=

# ── Contact form ─────────────────────────────────────────────────────────
# Web3Forms access key used by ContactPage.tsx to send submissions.
VITE_WEB3FORMS_ACCESS_KEY=

# ── Social links (optional) ──────────────────────────────────────────────
# Leave blank to hide the corresponding icon in the footer instead of
# shipping a dead '#' link.
VITE_INSTAGRAM_URL=
VITE_TWITTER_URL=
VITE_YOUTUBE_URL=
